<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ================= MAIN CONTENT ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#003366"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btnOpenSidebar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_menu"
                android:background="@android:color/transparent"
                app:tint="#FFFFFF"
                android:contentDescription="Menu"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginStart="12dp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Dashboard Content -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Dashboard Summary Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dashboard Summary"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp"/>

                <!-- Cards Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4"
                    android:baselineAligned="false">

                    <!-- Total Courses -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:background="@drawable/card_blue_bg"
                        android:layout_margin="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Courses"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:id="@+id/totalCourses"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Total Exams -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:background="@drawable/card_green_bg"
                        android:layout_margin="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Exams"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:id="@+id/totalExams"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Total Examinees -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:background="@drawable/card_yellow_bg"
                        android:layout_margin="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Examinees"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:id="@+id/totalExaminees"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Total Teachers -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:background="@drawable/card_red_bg"
                        android:layout_margin="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Teachers"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:id="@+id/totalTeachers"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                </LinearLayout>

                <!-- Charts Section - Replaced with CardView placeholders -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginTop="24dp">

                    <!-- Exam Performance Chart Placeholder -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="250dp"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📊 Exam Performance"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#333333"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bar Chart Placeholder"
                                android:textSize="14sp"
                                android:textColor="#666666"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- System Summary Chart Placeholder -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="250dp"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📈 System Summary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#333333"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pie Chart Placeholder"
                                android:textSize="14sp"
                                android:textColor="#666666"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ================= SIDEBAR ================= -->
    <LinearLayout
        android:id="@+id/sidebarLayout"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#00BCD4"
        android:padding="16dp"
        android:layout_marginTop="?attr/actionBarSize">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Profile -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_person"
                        android:scaleType="centerCrop"
                        android:background="@drawable/profile_circle_bg"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Admin"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="8dp"/>

                <!-- Manage Curriculum Header -->
                <Button
                    android:id="@+id/btnManageCurriculumHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📘 Manage Curriculum ▾"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:background="@android:color/transparent"
                    android:padding="8dp"/>

                <!-- Curriculum Dropdown -->
                <LinearLayout
                    android:id="@+id/curriculumDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingStart="16dp">

                    <Button
                        android:id="@+id/btnManageSpecializations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Specialization"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"/>

                    <Button
                        android:id="@+id/btnManageYears"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Year"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"/>

                    <Button
                        android:id="@+id/btnManageSections"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Sections"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"/>

                    <Button
                        android:id="@+id/btnManageCourse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Course"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"/>

                    <Button
                        android:id="@+id/btnManageSubjects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Subjects"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"/>
                </LinearLayout>

                <!-- Manage Accounts Header -->
                <Button
                    android:id="@+id/btnManageAccountsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👤 Manage Accounts ▾"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:background="@android:color/transparent"
                    android:padding="8dp"/>

                <!-- Accounts Dropdown -->
                <LinearLayout
                    android:id="@+id/accountsDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingStart="16dp">

                    <Button
                        android:id="@+id/btnManageTeachers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Teacher"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"/>

                    <Button
                        android:id="@+id/btnManageStudents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Examinee"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"/>
                </LinearLayout>

                <!-- Logout -->
                <Button
                    android:id="@+id/logoutBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚪 Logout"
                    android:textAllCaps="false"
                    android:textColor="#FFEBEE"
                    android:background="@android:color/transparent"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>