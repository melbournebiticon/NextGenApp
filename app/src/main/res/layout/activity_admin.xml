<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <Button
        android:id="@+id/btnManageSpecializations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Specializations"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnManageYears"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Years"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnManageSections"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Sections"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnManageCourse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Departments"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnManageSubjects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Subjects"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnManageTeachers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Teachers"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnManageStudents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage Students"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/logoutBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:backgroundTint="@android:color/holo_red_light"
        android:text="Logout"
        android:textColor="@android:color/white" />

</LinearLayout>
