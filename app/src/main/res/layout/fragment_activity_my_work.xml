<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Submission Status -->
        <TextView
            android:id="@+id/tvWorkStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No submission yet"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#333"
            android:padding="10dp"
            android:background="#F5F5F5"
            android:layout_marginBottom="8dp"
            android:gravity="center"/>

        <!-- Max Score (added to match code) -->
        <TextView
            android:id="@+id/tvMaxScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Max Score: 0"
            android:textSize="14sp"
            android:textColor="#444"
            android:layout_marginBottom="8dp"
            android:gravity="center"/>

        <!-- Due date display (optional, helpful for users) -->

        <!-- Deadline Warning -->
        <TextView
            android:id="@+id/tvDeadlineNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You have not uploaded any work for this activity."
            android:textColor="#C62828"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            android:padding="12dp"
            android:background="#FFEBEE"
            android:layout_marginBottom="16dp"/>

        <!-- File Picker Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:id="@+id/fileBox"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="No file selected"
                    android:textColor="#444"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/btnSelectFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp" />
            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Preview Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvPreviewFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#000" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your score will appear here"
                    android:textSize="16sp"
                    android:textColor="#444"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvViewed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not yet viewed"
                    android:textSize="16sp"
                    android:textColor="#555"
                    android:layout_marginTop="4dp"/>

                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:contentDescription="Image preview" />

                <VideoView
                    android:id="@+id/videoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:visibility="gone"
                    android:layout_marginTop="12dp"
                    android:contentDescription="Video preview" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Work"
            android:visibility="gone"
            android:textSize="16sp"
            android:padding="12dp"
            android:backgroundTint="#1976D2"
            android:textColor="#fff"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>