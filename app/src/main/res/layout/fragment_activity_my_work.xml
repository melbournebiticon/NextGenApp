<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Status / Existing submission -->
    <TextView
        android:id="@+id/tvWorkStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No submission yet"
        android:textSize="16sp"
        android:padding="8dp" />

    <!-- File selection box -->
    <LinearLayout
        android:id="@+id/fileBox"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/rectangle_border">

        <!-- File name will appear here -->
        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No file selected"
            android:textSize="16sp"
            android:ellipsize="end"
            android:singleLine="true" />

        <!-- Select file button -->
        <Button
            android:id="@+id/btnSelectFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select File" />

        <TextView
            android:id="@+id/tvDeadlineNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You have not uploaded any work for this activity."
            android:textColor="@android:color/holo_red_dark"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            android:padding="8dp" />

        <LinearLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#EEEEEE"
            android:visibility="gone"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvPreviewFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#000"
                android:textStyle="bold"
                android:textSize="16sp" />
            <!-- Score -->
            <TextView
                android:id="@+id/tvScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Score: Pending"
                android:textSize="16sp"
                android:paddingTop="4dp"/>

            <!-- Viewed status -->
            <TextView
                android:id="@+id/tvViewed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Viewed: No"
                android:textSize="16sp"
                android:paddingTop="2dp"/>


            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

    <!-- Submit Work button (hidden until file selected) -->
    <Button
        android:id="@+id/btnSubmitFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit Work"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>
