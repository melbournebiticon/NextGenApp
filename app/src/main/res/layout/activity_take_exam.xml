<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFE">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:background="@color/dark_blue_700"
        android:gravity="center_vertical"
        android:elevation="10dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:clipToPadding="false">

        <TextView
            android:id="@+id/tvExamTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NextGen | Portal"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minWidth="80dp"
            android:gravity="center"
            android:text="00:00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:background="@color/white"
            android:paddingHorizontal="16dp"
            android:layout_marginStart="16dp"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

    <!-- Row with Progress at Left and Button at Right, both below topbar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerLayout"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="6dp">

        <!-- Progress (left) -->
        <TextView
            android:id="@+id/tvQuestionProgress"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="1/5"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:paddingHorizontal="20dp"
            android:backgroundTint="#FAFAFA"
            android:clipToOutline="true"
            android:elevation="3dp"
            android:layout_gravity="center_vertical" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Button (right side) -->
        <Button
            android:id="@+id/btnSubmitExam"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:text="✓"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_square_gradient_button"
            android:elevation="7dp"
            android:gravity="center" />

    </LinearLayout>

    <!-- RecyclerView below the row -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvQuestions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/bottomBar"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false"
        tools:listitem="@layout/item_student_exam" />

</RelativeLayout>