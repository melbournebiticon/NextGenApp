<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:clipToPadding="false">

    <!-- ================= MAIN CONTENT ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F4F6FA"
        android:fitsSystemWindows="true">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="#003366"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnToggleSidebar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:contentDescription="Toggle sidebar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Manage Subjects"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Content Area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Add Subject Button -->
            <Button
                android:id="@+id/btnAddSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Add New Subject"
                android:backgroundTint="#003366"
                android:textColor="#FFFFFF"
                android:layout_gravity="end"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DDDDDD"
                android:layout_marginVertical="16dp"/>

            <!-- Subjects RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSubjects"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

        </LinearLayout>
    </LinearLayout>

    <!-- ================= SIDEBAR ================= -->
    <LinearLayout
        android:id="@+id/sidebarLayout"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#00BCD4"
        android:fitsSystemWindows="true">

        <!-- Scrollable Content - FIXED HEIGHT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:fitsSystemWindows="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Profile Section - CENTERED -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/profileImage"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_person"
                        android:scaleType="centerCrop"
                        android:background="@drawable/profile_circle_bg"
                        android:layout_marginBottom="12dp"
                        android:contentDescription="Profile picture" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Admin"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:gravity="center"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"/>

                <!-- Manage Curriculum Header - CENTERED -->
                <Button
                    android:id="@+id/btnManageCurriculumHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📘 Manage Curriculum ▾"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:background="@android:color/transparent"
                    android:padding="16dp"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Curriculum Dropdown - CENTERED -->
                <LinearLayout
                    android:id="@+id/curriculumDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnManageSpecializations"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Specialization"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"
                        android:padding="14dp"
                        android:gravity="center"
                        android:textSize="14sp"/>

                    <Button
                        android:id="@+id/btnManageYears"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Year"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"
                        android:padding="14dp"
                        android:gravity="center"
                        android:textSize="14sp"/>

                    <Button
                        android:id="@+id/btnManageSections"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Sections"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"
                        android:padding="14dp"
                        android:gravity="center"
                        android:textSize="14sp"/>

                    <Button
                        android:id="@+id/btnManageCourse"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Course"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"
                        android:padding="14dp"
                        android:gravity="center"
                        android:textSize="14sp"/>

                    <Button
                        android:id="@+id/btnManageSubjects"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Subjects"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"
                        android:padding="14dp"
                        android:gravity="center"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- Manage Accounts Header - CENTERED -->
                <Button
                    android:id="@+id/btnManageAccountsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="👤 Manage Accounts ▾"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:background="@android:color/transparent"
                    android:padding="16dp"
                    android:gravity="center"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <!-- Accounts Dropdown - CENTERED -->
                <LinearLayout
                    android:id="@+id/accountsDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnManageTeachers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Teacher"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"
                        android:padding="14dp"
                        android:gravity="center"
                        android:textSize="14sp"/>

                    <Button
                        android:id="@+id/btnManageStudents"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Manage Examinee"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:background="@android:color/transparent"
                        android:padding="14dp"
                        android:gravity="center"
                        android:textSize="14sp"/>
                </LinearLayout>

                <!-- Logout - CENTERED -->
                <Button
                    android:id="@+id/logoutBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🚪 Logout"
                    android:textAllCaps="false"
                    android:textColor="#FFEBEE"
                    android:background="@android:color/transparent"
                    android:layout_marginTop="24dp"
                    android:padding="16dp"
                    android:gravity="center"
                    android:textSize="16sp"/>

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>