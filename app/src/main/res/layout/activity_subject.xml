<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".admin.SubjectActivity">

    <!-- ===== MAIN CONTENT ===== -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0F3F9">

        <!-- ===== APP BAR WITH TOOLBAR ===== -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="#0D47A1"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                app:title="Manage Subjects"
                app:titleTextColor="@android:color/white" />
        </com.google.android.material.appbar.AppBarLayout>

        <!-- ===== MAIN CONTENT ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:background="#F0F3F9">

            <!-- Input Section Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:background="#FFFFFF">

                    <!-- Subject Code Input -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subject Code"
                        android:textColor="#0D47A1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etSubjectCode"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Enter subject code"
                        android:background="@drawable/edit_text_background"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Subject Name Input -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subject Name"
                        android:textColor="#0D47A1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <EditText
                        android:id="@+id/etSubjectName"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Enter subject name"
                        android:background="@drawable/edit_text_background"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- Course Spinner -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Select Course"
                        android:textColor="#0D47A1"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <Spinner
                        android:id="@+id/spinnerCourseOption"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:background="@android:drawable/btn_dropdown"
                        android:padding="12dp"
                        android:layout_marginBottom="24dp"/>

                    <!-- Add Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAddSubject"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Add Subject"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:backgroundTint="#0D47A1"
                        android:textColor="#FFFFFF"
                        android:stateListAnimator="@null"
                        android:letterSpacing="0.02"
                        android:padding="0dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Subjects List Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="#FFFFFF">

                    <!-- Card Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="#F8F9FA">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_list"
                            android:tint="#0D47A1"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="List"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Subjects List"
                            android:textColor="#0D47A1"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvSubjectCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 items"
                            android:textColor="#555555"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerSubjects"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone"
                        android:padding="40dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/ic_empty_specializations"
                            android:tint="#CCCCCC"
                            android:contentDescription="No subjects"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Subjects Found"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#555555"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:text="Add a new subject using the form above"
                            android:textSize="14sp"
                            android:textColor="#999999"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- ===== NAVIGATION VIEW (SIDEBAR) ===== -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_admin"
        app:menu="@menu/admin_navigation_menu" />

</androidx.drawerlayout.widget.DrawerLayout>