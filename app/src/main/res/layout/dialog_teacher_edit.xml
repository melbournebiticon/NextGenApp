<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <!-- Profile Picture -->
        <ImageView
            android:id="@+id/ivEditProfile"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/examinee_default"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_bg_light"
            android:padding="4dp"
            android:contentDescription="Profile Image"
            android:clickable="true"
            android:focusable="true" />

        <!-- Upload Progress (optional, hidden by default) -->
        <ProgressBar
            android:id="@+id/progressBarUpload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUploadProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Uploading..."
            android:textSize="12sp"
            android:textColor="#666"
            android:visibility="gone" />

        <!-- Full Name -->
        <EditText
            android:id="@+id/etEditFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name"
            android:inputType="textPersonName" />

        <!-- Birthday -->
        <EditText
            android:id="@+id/etEditBirthday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Birthday"
            android:inputType="date"
            android:layout_marginTop="8dp" />

        <!-- Email -->
        <EditText
            android:id="@+id/etEditEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:layout_marginTop="8dp" />

        <!-- RecyclerView for multiple course selection -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerEditCourses"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="8dp"
            android:scrollbars="vertical" />

        <!-- RecyclerView for subjects -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerEditSubjects"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:scrollbars="vertical" />

    </LinearLayout>
</ScrollView>
