<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_history_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardElevation="6dp"
    app:cardCornerRadius="12dp"
    app:cardUseCompatPadding="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/statCardBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Date -->
        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="2025-12-06"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="@color/primaryText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvHistoryStatus"
            app:layout_constraintHorizontal_bias="0" />

        <!-- Status chip-like badge -->
        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="Present"
            android:textColor="@color/teal_700"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:background="@drawable/rounded_background_subtle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/tvHistoryDate" />

        <!-- Meta (section / teacher) -->
        <TextView
            android:id="@+id/tvHistoryMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="BSCS - Section A • By Prof. Santos"
            android:textAppearance="@style/TextAppearance.AppCompat.Body2"
            android:textColor="@color/secondaryText"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@id/tvHistoryDate"
            app:layout_constraintTop_toBottomOf="@id/tvHistoryDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>