<?xml version="1.0" encoding="utf-8"?>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"> <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent" app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"  app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/white"> <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/iconCode"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_code"
                    android:tint="@color/dark_blue_500" app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvSubjectCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Subject Code: ---"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@color/onSurface" android:fontFamily="sans-serif-medium"
                    app:layout_constraintTop_toTopOf="@id/iconCode"
                    app:layout_constraintBottom_toBottomOf="@id/iconCode"
                    app:layout_constraintStart_toEndOf="@id/iconCode"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <View
                    android:id="@+id/divider1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider" android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/iconCode"
                    app:layout_constraintStart_toStartOf="parent" />

                <ImageView
                    android:id="@+id/iconBook"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_book"
                    android:tint="@color/dark_blue_700" android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/divider1"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvSubjectName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Subject Name: ---"
                    android:textSize="16sp"
                    android:textColor="@color/onSurfaceVariant" android:fontFamily="sans-serif"
                    app:layout_constraintTop_toTopOf="@id/iconBook"
                    app:layout_constraintBottom_toBottomOf="@id/iconBook"
                    app:layout_constraintStart_toEndOf="@id/iconBook"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <ImageView
                    android:id="@+id/iconPerson"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_person"
                    android:tint="@color/dark_blue_700" android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/iconBook"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tvTeacherName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Teacher: ---"
                    android:textSize="16sp"
                    android:textColor="@color/onSurfaceVariant" android:fontFamily="sans-serif"
                    app:layout_constraintTop_toTopOf="@id/iconPerson"
                    app:layout_constraintBottom_toBottomOf="@id/iconPerson"
                    app:layout_constraintStart_toEndOf="@id/iconPerson"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPerformance"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:text="View Performance"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textAllCaps="false"
                    android:fontFamily="sans-serif-medium"
                    app:icon="@drawable/ic_chart"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:cornerRadius="12dp"
                    app:backgroundTint="@color/dark_blue_700" app:elevation="4dp"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    app:layout_constraintTop_toBottomOf="@id/tvTeacherName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Activities"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/onBackground" android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"/>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerStudentActivities"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp"
            android:overScrollMode="never"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_activity_student"/>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>