<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_history_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <TextView
        android:id="@+id/dialogHistoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Attendance History"
        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:textStyle="bold"
        android:paddingBottom="8dp"
        android:importantForAccessibility="yes" />

    <!-- RecyclerView uses 0dp + weight so the dialog can size correctly and the list can scroll -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/dialogHistoryRv"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="160dp"
        android:clipToPadding="false"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/dialogHistoryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No attendance records found."
        android:visibility="gone"
        android:paddingTop="12dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:importantForAccessibility="yes" />

</LinearLayout>