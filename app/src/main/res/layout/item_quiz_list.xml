<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:material="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardQuizRoot"
    android:layout_margin="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="16dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- QUIZ TITLE -->
        <TextView
            android:id="@+id/tvQuizTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz Title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:maxLines="1"
            android:ellipsize="end"/>

        <!-- SECTION -->
        <TextView
            android:id="@+id/tvQuizSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Section"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"/>

        <!-- SUBJECT -->
        <TextView
            android:id="@+id/tvQuizSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subject"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:ellipsize="end"
            android:maxLines="1"/>

        <!-- TEACHER -->
        <TextView
            android:id="@+id/tvQuizTeacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Teacher"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"/>

        <!-- DURATION -->
        <TextView
            android:id="@+id/tvQuizDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Duration: 30 mins"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:visibility="gone"/>

        <!-- SCHEDULE -->
        <TextView
            android:id="@+id/tvQuizSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Schedule"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTakeQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Take Quiz"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            app:cornerRadius="8dp"
            style="@style/Widget.MaterialComponents.Button" />

        <!-- Optional label when quiz is already taken -->
        <TextView
            android:id="@+id/tvQuizTaken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Taken"
            android:textColor="#888888"
            android:visibility="gone"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
