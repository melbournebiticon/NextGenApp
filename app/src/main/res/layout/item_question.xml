<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/questionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    android:layout_marginHorizontal="2dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:id="@+id/questionContainer"
        android:padding="12dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white">

        <!-- Question Text -->
        <TextView
            android:id="@+id/tvQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Question text here"
            android:textSize="16sp"
            android:textColor="@color/dark_blue_700"
            android:textStyle="bold"/>

        <!-- Question Type & Answer -->
        <TextView
            android:id="@+id/tvQuestionType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Type | Answer"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="2dp"/>

        <!-- Edit & Delete Buttons -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:icon="@drawable/ic_edit"
                app:iconPadding="8dp"
                android:iconTint="@color/teal_700"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/teal_700"
                android:backgroundTint="@android:color/white"
                android:strokeColor="@color/teal_700"
                app:strokeWidth="2dp"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:icon="@drawable/ic_delete"
                app:iconPadding="8dp"
                android:iconTint="@android:color/holo_red_dark"
                android:textAllCaps="false"
                android:textColor="@android:color/holo_red_dark"
                android:textStyle="bold"
                android:backgroundTint="@android:color/white"
                android:strokeColor="@android:color/holo_red_dark"
                app:strokeWidth="2dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>