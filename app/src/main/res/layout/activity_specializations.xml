<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F5F5F5">

    <!-- ================= MAIN CONTENT ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Enhanced Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="#003366"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:elevation="4dp">

            <ImageButton
                android:id="@+id/btnOpenSidebar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_menu"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:tint="#FFFFFF"
                android:contentDescription="Menu"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Manage Specializations"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginStart="16dp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_category"
                android:tint="#FFFFFF"
                android:contentDescription="Specializations Icon"/>
        </LinearLayout>

        <!-- Main Content - Simplified -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#F5F5F5">

            <!-- Add Button Section -->
            <Button
                android:id="@+id/addSpecializationBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Add New Specialization"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/button_primary"
                android:textColor="#FFFFFF"
                android:drawableStart="@drawable/ic_add"
                android:drawableTint="#FFFFFF"
                android:drawablePadding="8dp"
                android:layout_marginBottom="16dp"/>

            <!-- Specializations List Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:background="#FFFFFF">

                    <!-- Card Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="#F8F9FA">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_list"
                            android:tint="#003366"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="List"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Specializations List"
                            android:textColor="#003366"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvSpecializationCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 items"
                            android:textColor="#666666"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/specializationRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone"
                        android:padding="40dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/ic_empty_specializations"
                            android:tint="#CCCCCC"
                            android:contentDescription="No specializations"
                            android:layout_marginBottom="16dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Specializations Found"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#666666"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="200dp"
                            android:layout_height="wrap_content"
                            android:text="Click 'Add New Specialization' to create one"
                            android:textSize="14sp"
                            android:textColor="#999999"
                            android:gravity="center"
                            android:lineSpacingExtra="4dp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>

    <!-- ================= SIDEBAR - Same as before ================= -->
    <LinearLayout
        android:id="@+id/sidebarLayout"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#00BCD4"
        android:padding="0dp">

        <!-- Sidebar Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#00BCD4"
            android:padding="20dp">

            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_person"
                android:scaleType="centerCrop"
                android:background="@drawable/profile_circle_bg"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administrator"
                android:textColor="#E0F7FA"
                android:textSize="12sp"/>
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none"
            android:background="#00BCD4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="8dp">

                <!-- Manage Curriculum Header -->
                <Button
                    android:id="@+id/btnManageCurriculumHeader"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📘 Manage Curriculum ▴"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="@android:color/transparent"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:drawableTint="#FFFFFF"/>

                <!-- Curriculum Dropdown -->
                <LinearLayout
                    android:id="@+id/curriculumDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:background="#0097A7"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <Button
                        android:id="@+id/btnManageSpecializations"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Manage Specialization"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="32dp"
                        android:background="@drawable/sidebar_button_pressed"/>

                    <Button
                        android:id="@+id/btnManageYears"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Manage Year"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="32dp"
                        android:background="@android:color/transparent"/>

                    <Button
                        android:id="@+id/btnManageSections"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Manage Sections"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="32dp"
                        android:background="@android:color/transparent"/>

                    <Button
                        android:id="@+id/btnManageCourse"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Manage Course"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="32dp"
                        android:background="@android:color/transparent"/>

                    <Button
                        android:id="@+id/btnManageSubjects"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Manage Subjects"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="32dp"
                        android:background="@android:color/transparent"/>
                </LinearLayout>

                <!-- Manage Accounts Header -->
                <Button
                    android:id="@+id/btnManageAccountsHeader"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="👤 Manage Accounts ▾"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:background="@android:color/transparent"
                    android:drawableEnd="@drawable/ic_arrow_down"
                    android:drawableTint="#FFFFFF"/>

                <!-- Accounts Dropdown -->
                <LinearLayout
                    android:id="@+id/accountsDropdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="#0097A7"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <Button
                        android:id="@+id/btnManageTeachers"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Manage Teacher"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="32dp"
                        android:background="@android:color/transparent"/>

                    <Button
                        android:id="@+id/btnManageStudents"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Manage Examinee"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="32dp"
                        android:background="@android:color/transparent"/>
                </LinearLayout>

                <!-- Logout -->
                <Button
                    android:id="@+id/logoutBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="🚪 Logout"
                    android:textAllCaps="false"
                    android:textColor="#FFEBEE"
                    android:textSize="14sp"
                    android:gravity="start|center_vertical"
                    android:paddingStart="20dp"
                    android:background="@android:color/transparent"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>