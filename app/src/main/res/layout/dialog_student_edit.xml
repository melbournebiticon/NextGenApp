<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F0F3F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== HEADER CARD ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#0D47A1"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Examinee"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:padding="20dp"/>
        </androidx.cardview.widget.CardView>

        <!-- ===== FORM CARD ===== -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Full Name Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Full Name"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1"
                    android:layout_marginBottom="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etEditFullName"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Enter full name"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@android:color/transparent"
                        android:textSize="14sp"
                        android:textColor="#0D47A1"
                        android:textColorHint="#999999"/>
                </androidx.cardview.widget.CardView>

                <!-- Birthday Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Birthday"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1"
                    android:layout_marginBottom="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etEditBirthday"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="MM/DD/YYYY"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@android:color/transparent"
                        android:textSize="14sp"
                        android:textColor="#0D47A1"
                        android:textColorHint="#999999"
                        android:focusable="false"
                        android:clickable="true"/>
                </androidx.cardview.widget.CardView>

                <!-- Email Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1"
                    android:layout_marginBottom="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etEditEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Enter email address"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:inputType="textEmailAddress"
                        android:background="@android:color/transparent"
                        android:textSize="14sp"
                        android:textColor="#0D47A1"
                        android:textColorHint="#999999"/>
                </androidx.cardview.widget.CardView>

                <!-- Contact Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contact Number"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1"
                    android:layout_marginBottom="8dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="24dp">

                    <EditText
                        android:id="@+id/etEditContact"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Enter contact number"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:inputType="phone"
                        android:background="@android:color/transparent"
                        android:textSize="14sp"
                        android:textColor="#0D47A1"
                        android:textColorHint="#999999"/>
                </androidx.cardview.widget.CardView>

                <!-- Course Selection Section -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Select Course"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1"
                    android:layout_marginBottom="12dp"/>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="16dp">

                    <Spinner
                        android:id="@+id/spinnerEditCourses"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@android:color/transparent"
                        android:textColor="#0D47A1"/>
                </androidx.cardview.widget.CardView>

                <!-- ===== ACTION BUTTONS ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal"
                    android:layout_marginTop="16dp">

                    <!-- Cancel Button -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#F5F5F5">

                        <Button
                            android:id="@+id/btnCancelEdit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Cancel"
                            android:textSize="14sp"
                            android:textColor="#555555"
                            android:background="@android:color/transparent"/>
                    </androidx.cardview.widget.CardView>

                    <!-- Save Button -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#0D47A1">

                        <Button
                            android:id="@+id/btnSaveEdit"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Save Changes"
                            android:textSize="14sp"
                            android:textColor="#FFFFFF"
                            android:background="@android:color/transparent"/>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>