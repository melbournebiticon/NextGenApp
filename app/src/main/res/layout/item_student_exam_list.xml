<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    android:backgroundTint="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="12dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Status Chip -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatus"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:textSize="11sp"
            android:textStyle="bold"
            app:chipBackgroundColor="?attr/colorSecondaryContainer"
            app:chipCornerRadius="12dp"
            app:chipStartPadding="8dp"
            app:chipEndPadding="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="ACTIVE" />

        <!-- Exam Title -->
        <TextView
            android:id="@+id/tvExamTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintTop_toBottomOf="@id/chipStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Advanced Quantum Computing Theory Final Exam" />

        <!-- Course Icon -->
        <ImageView
            android:id="@+id/icCourse"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_book"
            app:tint="?attr/colorPrimary"
            app:layout_constraintTop_toBottomOf="@id/tvExamTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Course Name -->
        <TextView
            android:id="@+id/tvCourseDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@id/icCourse"
            app:layout_constraintStart_toEndOf="@id/icCourse"
            app:layout_constraintEnd_toStartOf="@id/btnTakeExam"
            tools:text="BSIT - SD - 1A" />

        <!-- Teacher Icon -->
        <ImageView
            android:id="@+id/icTeacher"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_person"
            app:tint="?attr/colorTertiary"
            app:layout_constraintTop_toBottomOf="@id/icCourse"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Teacher Name -->
        <TextView
            android:id="@+id/tvTeacherName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@id/icTeacher"
            app:layout_constraintStart_toEndOf="@id/icTeacher"
            app:layout_constraintEnd_toStartOf="@id/btnTakeExam"
            tools:text="Prof. Anna Ruiz" />

        <!-- Schedule Icon -->
        <ImageView
            android:id="@+id/icSchedule"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_calendar"
            app:tint="?attr/colorPrimary"
            app:layout_constraintTop_toBottomOf="@id/icTeacher"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Schedule -->
        <TextView
            android:id="@+id/tvSchedule"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="@id/icSchedule"
            app:layout_constraintStart_toEndOf="@id/icSchedule"
            app:layout_constraintEnd_toStartOf="@id/btnTakeExam"
            tools:text="Dec 18, 2025 at 11:00 AM" />

        <!-- Take Exam Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTakeExam"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Start"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="textEnd"
            app:iconSize="16dp"
            style="@style/Widget.Material3.Button.TonalButton"
            app:layout_constraintTop_toTopOf="@id/icCourse"
            app:layout_constraintBottom_toBottomOf="@id/tvSchedule"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
