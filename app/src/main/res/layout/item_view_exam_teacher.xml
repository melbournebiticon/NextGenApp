<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Student Avatar & Name Section -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Avatar Circle -->
            <View
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/examinee_default"
                android:layout_marginEnd="12dp"/>

            <!-- Student Info Container -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- Student Name -->
                <TextView
                    android:id="@+id/tvStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Student Name"
                    android:textColor="#1E3A8A"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Student ID -->
                <TextView
                    android:id="@+id/tvStudentId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ID: 2021-0001"
                    android:textSize="12sp"
                    android:textColor="#64748B"
                    android:ellipsize="end"
                    android:maxLines="1"/>

            </LinearLayout>



            <!-- Present / Absent Button -->
            <Button
                android:id="@+id/btnMarkPresent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Absent"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_present_absent"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"/>


        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginBottom="16dp"/>

        <!-- Course Information -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Course:"
                android:textSize="14sp"
                android:textColor="#64748B"
                android:textStyle="normal"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvCourseInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BSIT - SD - 1 - A"
                android:textSize="14sp"
                android:textColor="#1E3A8A"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Status & Actions Row -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <!-- Attendance Counter Badge -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:background="@drawable/counter_badge_bg"
                android:padding="12dp"
                android:layout_marginEnd="12dp">

                <TextView
                    android:id="@+id/tvCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Answered: 0"
                    android:textSize="14sp"
                    android:textColor="#1E3A8A"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Enhanced Reset Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/reset_button_enhanced"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:minHeight="44dp"
                android:minWidth="88dp"
                android:textAllCaps="false"
                android:elevation="3dp"
                android:stateListAnimator="@animator/button_state_list_animator"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>