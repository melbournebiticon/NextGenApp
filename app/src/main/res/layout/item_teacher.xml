<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:elevation="4dp"
    android:backgroundTint="#FFFFFF"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Teacher ID -->
        <TextView
            android:id="@+id/tvTeacherId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TCHR-0001"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#000000"/>

        <!-- Full Name -->
        <TextView
            android:id="@+id/tvFullName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"/>

        <!-- Display Name -->
        <TextView
            android:id="@+id/tvDisplayName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="D.Name"
            android:textSize="14sp"
            android:textColor="#555555"/>

        <!-- Email -->
        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="teacher@email.com"
            android:textColor="#555555"
            android:layout_marginTop="2dp"/>

        <!-- Courses -->
        <TextView
            android:id="@+id/tvCourse"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Courses: Course1, Course2"
            android:textColor="#333333"
            android:layout_marginTop="2dp"/>

        <!-- Subjects -->
        <TextView
            android:id="@+id/tvSubjects"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Subjects: Subject1, Subject2"
            android:textColor="#333333"
            android:layout_marginTop="2dp"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnUpdateTeacher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:textColor="#FFFFFF"
                android:backgroundTint="#00BFFF"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnDeleteTeacher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Delete"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF4444"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
