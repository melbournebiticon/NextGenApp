<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/dark_blue_700"
        android:gravity="center_vertical"
        android:elevation="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NGX | EXAM"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="19sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:paddingStart="26dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="0dp"
        android:background="#F7F8FA">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="28dp"
            android:paddingBottom="36dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <!-- Top Info Section -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/white"
                android:padding="17dp"
                android:layout_marginBottom="17dp"
                android:elevation="2dp"
                android:layout_marginTop="10dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:clipToPadding="false">

                <TextView
                    android:id="@+id/tvCourseCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CS101"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#1B263B" />

                <TextView
                    android:id="@+id/tvSubjectName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Introduction to Programming"
                    android:textSize="16sp"
                    android:textColor="#415A77"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvTeacherName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mr. Smith"
                    android:textSize="15sp"
                    android:textColor="#1565C0"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Student ID Card Section -->
            <LinearLayout
                android:id="@+id/cardStudent"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="@android:color/white"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:elevation="4dp"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:clipToPadding="false">

                <!-- Profile Picture -->
                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:src="@drawable/examinee_default"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/image_border"
                    android:contentDescription="Profile Picture"
                    android:elevation="2dp"/>

                <!-- Student Info -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvStudentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Juan Dela Cruz"
                        android:textStyle="bold"
                        android:textSize="19sp"
                        android:textColor="#1B263B"
                        android:paddingBottom="3dp" />

                    <TextView
                        android:id="@+id/tvStudentId"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STD-0001"
                        android:textSize="15sp"
                        android:textColor="#415A77" />
                </LinearLayout>
            </LinearLayout>

            <!-- Score Section -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:background="@android:color/white"
                android:padding="18dp"
                android:elevation="4dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:clipToPadding="false">

                <!-- Big raw score -->
                <TextView
                    android:id="@+id/tvScoreRaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="34 / 50"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_blue_700"
                    android:gravity="center"
                    android:paddingBottom="2dp" />

                <!-- Percent -->
                <TextView
                    android:id="@+id/tvScorePercent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="68%"
                    android:textSize="18sp"
                    android:textColor="#415A77"
                    android:gravity="center"
                    android:paddingBottom="2dp" />

                <!-- Grade -->
                <TextView
                    android:id="@+id/tvEquivalentGrade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Passed"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1B263B"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>