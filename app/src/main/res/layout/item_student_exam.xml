<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white"
    android:layout_marginBottom="12dp">

    <!-- Question Text -->
    <TextView
        android:id="@+id/tvQuestion"
        android:text="1. Sample Question"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:textStyle="bold" />

    <!-- Multiple Choice Options (A–D) -->
    <RadioGroup
        android:id="@+id/radioGroupMCQ"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <RadioButton
            android:id="@+id/rbOptionA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A. Option A"
            android:padding="4dp" />

        <RadioButton
            android:id="@+id/rbOptionB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="B. Option B"
            android:padding="4dp" />

        <RadioButton
            android:id="@+id/rbOptionC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="C. Option C"
            android:padding="4dp" />

        <RadioButton
            android:id="@+id/rbOptionD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="D. Option D"
            android:padding="4dp" />
    </RadioGroup>

    <!-- True / False Options (Vertical) -->
    <RadioGroup
        android:id="@+id/radioGroupTF"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="4dp">

        <RadioButton
            android:id="@+id/rbTrue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="True"
            android:padding="4dp" />

        <RadioButton
            android:id="@+id/rbFalse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="False"
            android:padding="4dp" />
    </RadioGroup>

    <!-- Spinner for Matching Type -->
    <Spinner
        android:id="@+id/spinnerAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="8dp"/>

</LinearLayout>