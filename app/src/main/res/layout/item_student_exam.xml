<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="20dp"
    card_view:cardElevation="5dp"
    android:layout_marginBottom="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:background="#00000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@android:color/white">

        <!-- Question Header (Number & Type Badge) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvQuestionNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#1"
                android:textStyle="bold"
                android:textColor="#143D7A"
                android:textSize="16sp"
                android:background="@drawable/bg_qnum_circle"
                android:paddingVertical="2dp"
                android:paddingHorizontal="10dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvQuestionType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MCQ"
                android:textSize="12sp"
                android:textColor="#1976D2"
                android:background="@drawable/bg_questiontype_pill"
                android:paddingVertical="2dp"
                android:paddingHorizontal="10dp"/>

        </LinearLayout>

        <!-- Question Text -->
        <TextView
            android:id="@+id/tvQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is the capital of France?"
            android:textColor="#263238"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E3E9EF"
            android:layout_marginBottom="12dp"/>

        <!-- Multiple Choice Options (A–D) -->
        <RadioGroup
            android:id="@+id/radioGroupMCQ"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/rbOptionA"
                style="@style/ExamRadioButton"
                android:text="A. Paris" />

            <RadioButton
                android:id="@+id/rbOptionB"
                style="@style/ExamRadioButton"
                android:text="B. London" />

            <RadioButton
                android:id="@+id/rbOptionC"
                style="@style/ExamRadioButton"
                android:text="C. Berlin" />

            <RadioButton
                android:id="@+id/rbOptionD"
                style="@style/ExamRadioButton"
                android:text="D. Rome" />
        </RadioGroup>

        <!-- True / False Options -->
        <RadioGroup
            android:id="@+id/radioGroupTF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="2dp"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/rbTrue"
                style="@style/ExamRadioButton"
                android:text="True" />

            <RadioButton
                android:id="@+id/rbFalse"
                style="@style/ExamRadioButton"
                android:text="False" />
        </RadioGroup>

        <!-- EditText for Identification (optional, keep hidden if not needed) -->
        <EditText
            android:id="@+id/etAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_exam_edittext"
            android:hint="Type your answer here"
            android:padding="10dp"
            android:textColor="#263238"
            android:textSize="15sp"
            android:visibility="gone"/>

        <!-- Spinner for Matching Type -->
        <Spinner
            android:id="@+id/spinnerAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:spinnerMode="dropdown"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>