<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attendanceReportLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="0dp">

    <!-- Top App Bar with Back Button -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/dark_blue_700"
        android:theme="@style/ThemeOverlay.MaterialComponents.Light"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="Attendance Report"
        app:titleCentered="true"
        app:titleTextColor="@color/white"
        app:navigationIconTint="@color/white"/>

    <!-- Main Content Holder with Margin for Inner Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_weight="1">

        <!-- Report title + last updated -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvReportTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Section: BSCS 2A — Attendance Report"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/dark_blue_700" />

            <TextView
                android:id="@+id/tvLastUpdated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Last updated: —"
                android:textSize="12sp"
                android:textColor="#666"
                android:paddingStart="8dp" />
        </LinearLayout>

        <!-- Header Card with observable HSV -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="3dp"
            android:layout_marginBottom="10dp"
            android:padding="0dp"
            app:cardCornerRadius="12dp">

            <com.finale.nextgen.teacher.ObservableHorizontalScrollView
                android:id="@+id/header_hsv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/headerRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/h_no"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="No"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@android:color/background_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/h_student"
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:text="Student"
                        android:textStyle="bold"
                        android:paddingStart="12dp"
                        android:textColor="@android:color/background_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/h_present"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="P"
                        android:textColor="@android:color/background_dark"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/h_late"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="L"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@android:color/background_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/h_excused"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="E"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@android:color/background_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/h_absent"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="A"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@android:color/background_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/h_percentage"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@android:color/background_dark"
                        android:textSize="14sp" />

                </LinearLayout>
            </com.finale.nextgen.teacher.ObservableHorizontalScrollView>
        </androidx.cardview.widget.CardView>

        <!-- Controls: Calendar toggle + Compute Class Average + Export -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnToggleCalendar"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Show Calendar"
                android:background="@drawable/rounded_outline"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:padding="8dp" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnComputeClassAverage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Compute Class Average"
                android:background="@drawable/card_round"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <!-- Export button (small) -->
            <Button
                android:id="@+id/btnExport"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Export"
                android:backgroundTint="@color/green"
                android:textColor="@android:color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Calendar (hidden by default) -->
        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <!-- Shows info about selected date when calendar is visible -->
        <TextView
            android:id="@+id/attendanceTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attendance goes here"
            android:textColor="#444"
            android:padding="8dp" />

        <!-- Date info (bound to tvDateInfo in code) -->
        <TextView
            android:id="@+id/tvDateInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:text=""
            android:textColor="#444" />

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/attendanceRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

    </LinearLayout>

</LinearLayout>