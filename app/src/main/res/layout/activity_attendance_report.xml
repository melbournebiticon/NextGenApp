<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/attendanceReportLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/reportToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_blue_700"
        app:title="Attendance Report"
        app:titleTextColor="@android:color/white"
        app:titleCentered="true"
        app:navigationIcon="@drawable/ic_arrow_back"
        android:elevation="6dp" />

    <!-- Content container with padding -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_weight="1">

        <!-- Header Card with observable HSV -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:padding="0dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="@color/dark_blue_500">

            <com.finale.nextgen.teacher.ObservableHorizontalScrollView
                android:id="@+id/header_hsv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/headerRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="@color/dark_blue_600">

                    <TextView
                        android:id="@+id/h_no"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="No"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/h_student"
                        android:layout_width="220dp"
                        android:layout_height="wrap_content"
                        android:text="Student"
                        android:textStyle="bold"
                        android:paddingStart="12dp"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/h_present"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="P"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/h_late"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="L"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/h_excused"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="E"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/h_absent"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:text="A"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/h_percentage"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="%"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="14sp" />

                </LinearLayout>
            </com.finale.nextgen.teacher.ObservableHorizontalScrollView>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal|center_vertical"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleCalendar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:backgroundTint="@android:color/white"
                app:icon="@drawable/ic_calendar"
                app:iconTint="@color/blue_700"
                app:strokeColor="@color/blue_700"
                app:strokeWidth="2dp"
                app:cornerRadius="10dp"
                android:text=""
                />

            <View
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnComputeClassAverage"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:backgroundTint="@android:color/white"
                android:text="Compute Class Average"
                android:textColor="@color/blue_700"
                android:textStyle="bold"
                app:iconTint="@color/blue_700"
                app:strokeColor="@color/blue_700"
                app:strokeWidth="2dp"
                app:cornerRadius="10dp"/>
        </LinearLayout>

        <CalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvDateInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/dark_blue_500"
            android:paddingBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/attendanceRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_day_record" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvLastUpdated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Last updated: —"
                android:textSize="13sp"
                android:textColor="@color/dark_blue_500" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:text="Export CSV"
                android:textStyle="bold"
                android:textColor="@color/blue_700"
                app:strokeColor="@color/blue_700"
                app:strokeWidth="2dp"
                app:cornerRadius="10dp"
                android:icon="@drawable/ic_upload"
                android:iconTint="@color/blue_700"
                android:backgroundTint="@android:color/white"
                android:padding="10dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>