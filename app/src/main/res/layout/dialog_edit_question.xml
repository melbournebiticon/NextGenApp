<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Spinner
            android:id="@+id/spEditQType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:prompt="@string/prompt_question_type" />

        <EditText
            android:id="@+id/etEditQuestionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Question text"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginTop="8dp"/>

        <!-- MC Container -->
        <LinearLayout
            android:id="@+id/layoutEditMC"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <EditText android:id="@+id/etEditOptionA" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Option A"/>
            <EditText android:id="@+id/etEditOptionB" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Option B"/>
            <EditText android:id="@+id/etEditOptionC" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Option C"/>
            <EditText android:id="@+id/etEditOptionD" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Option D"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Correct Answer" android:layout_marginTop="6dp"/>
            <Spinner android:id="@+id/spEditMCAnswer" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- TF Container -->
        <LinearLayout
            android:id="@+id/layoutEditTF"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Correct Answer"/>
            <Spinner android:id="@+id/spEditTFAnswer" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Matching Container -->
        <LinearLayout
            android:id="@+id/layoutEditMatching"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <EditText
                android:id="@+id/etEditMatchAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Correct answer (matching)"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
