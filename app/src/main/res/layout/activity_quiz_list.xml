<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
        android:elevation="4dp"
        app:title="Available Quizzes"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleCentered="true"/>

    <!-- Main content below the top bar -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:padding="16dp">

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressQuizzes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center"/>

        <!-- Empty state -->
        <TextView
            android:id="@+id/tvNoQuizzes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No quizzes available"
            android:visibility="gone"
            android:gravity="center"
            android:layout_marginTop="24dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuizzes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            tools:listitem="@layout/item_quiz_list"/>

        <!-- Take Quiz Button (hidden by default, will show when QR is scanned) -->
        <Button
            android:id="@+id/btnTakeQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Take Quiz"
            android:visibility="gone"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

    <!-- Floating Action Button for Scan QR, placed at bottom end corner -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnScanQr"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="Scan quiz QR"
        app:srcCompat="@drawable/ic_qr_code_scanner"
        app:tint="@android:color/white"
        app:backgroundTint="@color/dark_blue_700"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>